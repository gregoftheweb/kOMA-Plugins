#!/usr/bin/env bash
# Install/upgrade kOMA Plugins, link the CLI, and place the widget on every
# panel left of the system tray. Safe to re-run: panels that already have it
# are left alone.
#   install            install + place on panels (panels restart for a moment)
#   install --no-place install/upgrade only
set -euo pipefail
dir=$(cd "$(dirname "$0")/.." && pwd)
# install only what `make package` ships (plus files not yet committed), never dev tooling
pkg=$(mktemp -d)
trap 'rm -rf "$pkg"' EXIT
(cd "$dir" && git ls-files -z --cached --others --exclude-standard -- metadata.json contents LICENSE |
  while IFS= read -r -d "" f; do if [ -e "$f" ]; then cp --parents "$f" "$pkg"; fi; done)
kpackagetool6 --type Plasma/Applet --upgrade "$pkg" >/dev/null 2>&1 ||
  kpackagetool6 --type Plasma/Applet --install "$pkg"
mkdir -p "$HOME/.local/bin"
icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
mkdir -p "$icons" && cp "$dir/contents/icons/koma.svg" "$icons/com.columbiafoundry.komaplugins.svg"
ln -sf "$dir/contents/code/komaplugin" "$HOME/.local/bin/komaplugin"
# Network use runs on systemd user timers: update checks at login and hourly,
# and a copy of the KDE Store catalog twice a day for the Get new tab
units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$units"
for u in komaplugin-refresh komaplugin-sync; do cp "$dir/systemd/$u.service" "$dir/systemd/$u.timer" "$units/"; done
systemctl --user daemon-reload
systemctl --user enable --now komaplugin-refresh.timer komaplugin-sync.timer >/dev/null 2>&1
# first install: fetch the store catalog now, in the background (about a minute)
[[ -f "${XDG_CACHE_HOME:-$HOME/.cache}/komaplugin/store.json" ]] ||
  systemctl --user start --no-block komaplugin-sync.service
echo "kOMA Plugins installed; CLI linked at ~/.local/bin/komaplugin; update check and store catalog timers on"
[[ "${1:-}" == "--no-place" ]] || "$dir/contents/code/komaplugin" enable com.columbiafoundry.komaplugins --yes
