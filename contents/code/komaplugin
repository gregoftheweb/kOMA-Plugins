#!/usr/bin/env python3
"""komaplugin — Omarchy-style plugin manager for KDE Plasma 6 (kOMA Plugins).

  komaplugin list [--all] [--type TYPE] [--json]   installed plugins and their state
  komaplugin status ID [--json]                    one plugin in detail
  komaplugin enable ID [--yes] [--no-restart]       turn on: place a widget on every
                                                   panel, enable a KWin script/effect
  komaplugin disable ID [--yes]                    turn off: take a widget off all
                                                   panels, disable a script/effect
  komaplugin use ID                                make a decoration or window
                                                   switcher the current one
  komaplugin remove ID [--yes]                     turn off, then move your copy to
                                                   ~/.local/share/komaplugin/removed/
  komaplugin browse [TYPE]                         open the KDE Store for a plugin type
  komaplugin add URL [--path DIR] [--enable] [--yes]
                                                   install a plugin from a git repo
  komaplugin clone ID [--yes]                      copy a plugin to your own id to edit
  komaplugin reload ID                             reinstall a git/cloned plugin from
                                                   its source folder after edits
  komaplugin refresh [--quiet]                     check the KDE Store and git for
                                                   updates (the only networked command;
                                                   a systemd timer runs it at login and
                                                   hourly) and cache the result
  komaplugin update ID|--all [--yes]               apply updates: git plugins fast-forward
                                                   with a diff first; store plugins open
                                                   KDE's store window on that entry

Plugins are KDE's own: Plasma widgets, KWin scripts, KWin effects, window
decorations, wallpaper plugins and window switchers. By default only add-ons
are listed (store, git, local and third-party packages); --all adds the ones
that ship with KDE itself.

Status: active (in use), off (installed, disabled or not placed),
        error (enabled but KWin failed to load it).
Origin: store (KDE Store), git (komaplugin add), clone (komaplugin clone),
        local (~/.local, hand or dev install),
        package (third-party distro package), kde (ships with KDE).
"""

import argparse
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

HOME = Path.home()
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
DATA_DIRS = [Path(p) for p in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if p]
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")

# type -> (label, kpackage type, data subdir, Qt plugin subdir for compiled ones)
TYPES = {
    "widget": ("Widgets", "Plasma/Applet", "plasma/plasmoids", "plasma/applets"),
    "kwin-script": ("KWin scripts", "KWin/Script", "kwin/scripts", None),
    "effect": ("Effects", "KWin/Effect", "kwin/effects", "kwin/effects/plugins"),
    "decoration": ("Window decorations", "KWin/Decoration", "kwin/decorations", "org.kde.kdecoration3"),
    "wallpaper": ("Wallpaper plugins", "Plasma/Wallpaper", "plasma/wallpapers", None),
    "window-switcher": ("Window switchers", "KWin/WindowSwitcher", "kwin/tabbox", None),
}
KNSRC = {
    "widget": "plasmoids.knsrc",
    "kwin-script": "kwinscripts.knsrc",
    "effect": "kwineffect.knsrc",
    "decoration": "window-decorations.knsrc",
    "wallpaper": "wallpaperplugin.knsrc",
    "window-switcher": "kwinswitcher.knsrc",
}
KPACKAGE_TO_TYPE = {v[1]: k for k, v in TYPES.items()}
STATE_DIR = DATA_HOME / "komaplugin"
SOURCES = STATE_DIR / "sources.json"
